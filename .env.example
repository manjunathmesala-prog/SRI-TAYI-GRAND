# SRI TAYI GRAND - ENVIRONMENT CONFIGURATION

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hotel Official Metadata
NEXT_PUBLIC_HOTEL_NAME="SRI TAYI GRAND"
NEXT_PUBLIC_HOTEL_PHONE="084942 23379"
NEXT_PUBLIC_HOTEL_WHATSAPP="+918494223379"
NEXT_PUBLIC_HOTEL_EMAIL="contact@sritayigrand.com"
NEXT_PUBLIC_HOTEL_ADDRESS="4585+F8J, Opp. Girls High School, Bypass Road, Kadiri – 515591, Anantapur District, Andhra Pradesh, India"

# Supabase (PostgreSQL, Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway (Test mode by default, replace with rzp_live_* in Production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Security & Cryptographic JWT Session Secrets
ADMIN_JWT_SECRET=generate_a_secure_64_character_random_hex_or_base64_string_for_production
ADMIN_MASTER_PASSWORD=GrandHotel@Kadiri2026!

# Role-Based Access Control (RBAC) Production Passwords
